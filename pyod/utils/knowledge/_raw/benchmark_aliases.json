{
  "_meta": {
    "purpose": "Per-benchmark raw detector name -> canonical pyod detector key (from algorithms.json) or an external/paper_only marker. Consumed by regenerate_kb.py (Phase A step 2) to attribute each benchmark matrix cell to a canonical detector within its modality.",
    "canonical_source": "pyod/utils/knowledge/algorithms.json (64 shipped detector keys)",
    "status_values": {
      "shipped": "pyod-shipped; runnable_by_make_plan=true; canonical key exists in algorithms.json",
      "external": "implemented in another maintained package (e.g. pygod) or as a benchmark-specific wrapper; runnable_by_make_plan=false; class_path=null in the KB",
      "paper_only": "method from a paper/benchmark with no maintained pyod/pygod class; runnable_by_make_plan=false",
      "planned": "scored from benchmark evidence and slated for pyod integration (committed plan / code in hand); runnable_by_make_plan=false until the class lands, then flips to shipped"
    },
    "text_keying": "Text entries decompose into (embedding, detector). The detector maps to a pyod canonical key; the full embed-then-detect pipeline is pyod.models.embedding.EmbeddingOD.",
    "unbenchmarked_policy": "pyod detectors absent from every source benchmark keep kb_score:null and coverage_n:0 in the regenerated KB, plus their existing qualitative fields (strengths/best_for/avoid_when). They are NEVER spliced from self-reported original-paper numbers, which are incomparable across datasets/protocols and systematically optimistic, and would corrupt within-dataset rank-normalization.",
    "subsequence_policy": "TSB-AD Sub-X entries are distinct subsequence-windowed TS methods, not the plain pyod detector; status=external with canonical pointing at the base detector for reference only (their TS performance is scored separately from the plain detector).",
    "ts_plain_policy": "Plain IForest/LOF/PCA/etc. in TSB-AD are the same pyod detector class applied to time series via windowing; they map to the same canonical key but are scored under the timeseries modality, separately from the tabular entry."
  },

